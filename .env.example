# Copy this file to .env and fill in your own values. Never commit .env.

# Required in every mode - free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# "sample" = offline sample travel data + local SQLite file (only GROQ_API_KEY needed)
# "live"   = real MCP servers (Tavily, AviationStack, OpenWeatherMap) + PostgreSQL
DATA_SOURCE=sample

# ---- live mode only ----
TAVILY_API_KEY=
# AVIATIONSTACK_API_KEY is accepted as well
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=
# Use a database of its own for this project, e.g. travel_planner
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_planner
# python.exe inside the aviationstack-mcp virtual environment (see README)
AVIATIONSTACK_MCP_PYTHON=
# Optional: defaults to the current Python and ./weather_mcp_server.py
WEATHER_MCP_PYTHON=
WEATHER_MCP_SCRIPT=

# ---- optional tuning ----
SQLITE_PATH=data/trip_plans.sqlite3
RESEARCH_TIMEOUT_SECONDS=45
MAX_REVISIONS=2
